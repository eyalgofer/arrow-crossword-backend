PORT=4177

# AWS — omit access keys to use the default CLI/credential chain
AWS_REGION=eu-north-1
S3_BUCKET=arrow-crossword-clue-images
S3_PUBLIC_BASE_URL=https://arrow-crossword-clue-images.s3.eu-north-1.amazonaws.com

# Mongo — must be the same database the app uses
MONGODB_URI=
MONGODB_DB=arrow-crossword
MONGODB_COLLECTION=image_clues

# Discovery
CANDIDATES_PER_CLUE=6
DISCOVERY_CONCURRENCY=3
USER_AGENT=ArrowCrosswordImagePipeline/1.0 (contact: you@example.com)
